{
  "name": "agoa-ope",
  "productName": "AGOA OPE",
  "version": "0.3.1",
  "description": "AGOA OPE — consultation et création des opérations (Ragic) — Agence Rémi Thollet",
  "main": "src/main.js",
  "author": "Agence Rémi Thollet",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never"
  },
  "devDependencies": { "electron": "^33.2.0", "electron-builder": "^25.1.8" },
  "build": {
    "appId": "fr.remithollet.agoa.ope",
    "productName": "AGOA OPE",
    "files": ["src/**/*", "package.json"],
    "directories": { "output": "dist" },
    "win": { "target": "nsis", "icon": "build/icon.ico" },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "AGOA-OPE-Setup-${version}.exe",
      "shortcutName": "AGOA OPE",
      "runAfterFinish": false
    }
  }
}
